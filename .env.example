# =====================================================
# AI in Finance — environment template
# =====================================================
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. Only GROQ_API_KEY is
# required for the default model; the other provider keys are only needed if you
# select that provider in the UI (the fallback router routes around missing ones).
#
# ---- File-based secrets (recommended for production) ----
# Instead of putting a value here, you can point any secret at a FILE whose
# contents are the value, using the `<NAME>_FILE` convention. This is how Docker
# secrets, Kubernetes secrets, and Vault sidecars supply secrets without ever
# placing them in an env var or the image. Example:
#     GROQ_API_KEY_FILE=/run/secrets/groq_api_key
# If both are set, `<NAME>_FILE` wins.

# ---- LLM providers ----
GROQ_API_KEY=            # required (default model + RAG + metric extraction)
OPENROUTER_API_KEY=      # optional
GEMINI_API_KEY=          # optional
ANTHROPIC_API_KEY=       # optional
CEREBRAS_API_KEY=        # optional
MISTRAL_API_KEY=         # optional

# ---- Web search (Deep Research) ----
TAVILY_API_KEY=          # optional; enables the "Search the web" toggle

# ---- Authentication ----
# JWT signing secret for login tokens. REQUIRED in production (the app refuses to
# start on a generated key when ENVIRONMENT=production). Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# AUTH_DB_PATH=./data/auth.db   # override to move the user store onto a volume

# ---- App / environment ----
ENVIRONMENT=development         # set to "production" for deployments
# LOG_LEVEL=INFO

# ---- Rate limiting (abuse control) ----
# Requests per minute per authenticated user across the API (chat/RAG/etc.).
# RATE_LIMIT_API_RPM=120
# Login/register attempts per minute per client IP (brute-force guard).
# RATE_LIMIT_AUTH_RPM=10
# Uploads per 5 minutes per user (uploads are heavier than chat).
# RATE_LIMIT_UPLOAD_PER_5MIN=30
# RATE_LIMIT_UPLOAD_BURST=30

# ---- Networking / CORS ----
# Comma-separated origins allowed to call the backend. Defaults to the local
# Streamlit origins; set your real frontend origin(s) in production.
# CORS_ALLOW_ORIGINS=https://app.example.com
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# BACKEND_API_URL=http://127.0.0.1:8000

# ---- HTTPS reverse proxy (Docker "production" profile) ----
# Public hostname served by the Caddy reverse proxy. "localhost" (default) uses
# Caddy's internal CA (self-signed, for local testing). Set a real domain and
# Caddy obtains a trusted Let's Encrypt certificate automatically. Start it with:
#     DOMAIN=app.example.com docker compose --profile production up -d --build
DOMAIN=localhost
