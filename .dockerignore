# Keep the build context small and never bake secrets or host-specific
# files into the image. (Note: financial_persona_prompts.md, requirements.txt
# and .streamlit/ are intentionally NOT ignored - they're needed at runtime.)

# Version control
.git/
.gitattributes

# Python caches & build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments (host-specific, useless inside the Linux image)
venv/
env/
ENV/
.venv/

# Secrets - provided at runtime via env_file, never copied into the image
.env

# Local runtime data (auto-created in the container or supplied via a volume)
data/
rag_storage/

# Editor / OS / tooling
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
